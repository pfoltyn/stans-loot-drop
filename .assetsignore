# Files that should NOT be uploaded to Cloudflare as static assets.
# Same syntax as .gitignore. Lives in the assets directory root.

# git internals
.git/
.gitignore

# wrangler internals
.wrangler/
wrangler.toml

# worker source — bundled into the Worker by wrangler, not served as a static asset
worker/

# build/dev tooling — not part of the deployed site
tools/

# repo docs / source — not part of the deployed site
README.md
*.py
__pycache__/
*.pyc

# fonts ship via Google Fonts CDN, not bundled
fonts/

# generated business-card artwork — for printing, not the public site
stans_loot_card.png

# original source images — only the framed WebPs in done/<Game>/ are served
orig/
orig_hd/

# scratch list of source URLs, not for the public site
urls.txt

# old flat duplicates and preview test images at done/ root
done/*.png
done/*.webp

# print-only PNG masters (kept in repo for reprints, not shipped to web)
done/**/*.png

# original JPG product photos — superseded by smaller WebP versions in real/
real/*.jpg
real/*.jpeg

# macOS junk
.DS_Store
